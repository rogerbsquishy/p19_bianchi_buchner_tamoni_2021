# This file serves as an example of what your .env file should look like.
# Replace the variables defined here with those applicable on your own system.
# Then copy the contents into a file called ".env" and place it in project's
# root directory. 

WRDS_USERNAME=jdoe

# Optional settings for the Bianchi, Buchner, and Tamoni (2021) replication.
# Defaults are shown; each can also be passed on the command line, e.g.
#   python src/forecast_oos.py --BBT_NN_NMC=8 --BBT_NN_NAVG=4
# BBT_SAMPLE_START=1971-08     # first forecast origin in the dataset
# BBT_SAMPLE_END=2017-12       # last forecast origin (returns realized through 2018-12)
# BBT_OOS_START=1989-01        # first out-of-sample forecast origin
# BBT_HYPER_FREQ=48            # months between hyperparameter searches
# BBT_NN_NMC=100               # networks trained per model (nMC)
# BBT_NN_NAVG=10               # best networks averaged (nAvg)
# BBT_NO_LOOKAHEAD=True        # False reproduces the provided code's training window
# BBT_N_JOBS=-1                # parallel workers
# FRED_MD_URL=https://files.stlouisfed.org/files/htdocs/fred-md/monthly/current.csv
